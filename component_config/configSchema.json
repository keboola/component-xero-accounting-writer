{
  "type": "object",
  "title": "Xero Accounting Writer",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant ID",
      "format": "select",
      "enum": [],
      "description": "Xero organisation ID. Leave blank to use the first available tenant.",
      "propertyOrder": 10,
      "options": {
        "async": {
          "label": "Re-load tenants",
          "action": "listTenants"
        }
      }
    },
    "skip_validation_errors": {
      "type": "boolean",
      "title": "Skip Validation Errors",
      "description": "When enabled, records that fail Xero validation are skipped with a warning. When disabled (default), the job fails if any record has validation errors.",
      "default": false,
      "propertyOrder": 15
    },
    "create_errors_table": {
      "type": "boolean",
      "title": "Create Errors Table",
      "description": "When enabled, records that fail Xero validation are written to an output table 'validation_errors' with columns: entity_type, record_id, errors.",
      "default": false,
      "propertyOrder": 16
    },
    "entities": {
      "title": "Entities to Write",
      "type": "array",
      "propertyOrder": 20,
      "items": {
        "type": "object",
        "required": ["entity_type", "write_mode", "source_table"],
        "title": "Entity",
        "properties": {
          "entity_type": {
            "title": "Entity Type",
            "type": "string",
            "enum": [
              "Contacts",
              "Invoices",
              "Payments",
              "PurchaseOrders",
              "ManualJournals",
              "Items",
              "CreditNotes",
              "Currencies",
              "Employees",
              "Quotes",
              "TrackingCategories",
              "BankTransactions"
            ],
            "options": {
              "enum_titles": [
                "Contacts",
                "Invoices",
                "Payments",
                "Purchase Orders",
                "Manual Journals",
                "Items",
                "Credit Notes",
                "Currencies",
                "Employees",
                "Quotes",
                "Tracking Categories",
                "Bank Transactions"
              ]
            },
            "propertyOrder": 10
          },
          "write_mode": {
            "title": "Write Mode",
            "description": "Create: add new records only. Upsert: create or update by Xero ID or reference.",
            "type": "string",
            "enum": ["create", "upsert"],
            "options": {
              "enum_titles": ["Create (POST)", "Upsert (POST + PUT)"]
            },
            "default": "upsert",
            "propertyOrder": 20
          },
          "source_table": {
            "title": "Input Table Name",
            "description": "The destination name of the input table as configured in storage mapping.",
            "type": "string",
            "propertyOrder": 30
          },
          "column_mapping": {
            "title": "Column Mapping",
            "description": "Map input table columns to Xero field names. If empty, all columns are passed as-is. Use 'Load Field Suggestions' to pre-fill required fields for the selected entity type.",
            "type": "array",
            "format": "table",
            "propertyOrder": 40,
            "items": {
              "type": "object",
              "required": ["source", "destination"],
              "title": "Column",
              "properties": {
                "source": {
                  "type": "string",
                  "title": "Source Column",
                  "enumSource": "columns"
                },
                "destination": {
                  "type": "string",
                  "title": "Xero Field Name"
                }
              }
            }
          },
          "load_field_suggestions": {
            "type": "button",
            "format": "sync-action",
            "title": "Load Field Suggestions",
            "description": "Matches input table columns to Xero field names. Requires the input table to be configured in storage mapping.",
            "propertyOrder": 35,
            "options": {
              "async": {
                "label": "Match Columns",
                "action": "loadFieldSuggestions",
                "cache": false
              }
            }
          }
        }
      }
    }
  }
}
